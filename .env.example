# Copy to .env.local and use Project settings > Your apps > Firebase SDK config.
# Leave these blank to run the browser-only demo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local testing only. Never enable this for a hosted build.
VITE_USE_FIREBASE_EMULATORS=false
